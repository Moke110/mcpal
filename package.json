{
  "name": "mcpal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "desktop": "electron src/desktop/main.ts",
    "controller": "node --env-file-if-exists=.env src/controller-cli.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "prismarine-item": "1.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "45.4.1",
    "minecraft-data": "3.119.0",
    "minecraft-protocol": "1.68.0",
    "prismarine-chunk": "1.41.0",
    "typescript": "~6.0.0",
    "vec3": "0.1.10"
  },
  "productName": "MC-Pal",
  "main": "src/desktop/main.ts"
}
