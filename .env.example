# 同一台电脑的局域网世界使用 localhost。端口取自游戏内「对局域网开放」提示。
MC_HOST=localhost
MC_PORT=
MC_VERSION=auto
# Microsoft 账号须拥有 Java Edition，并与真人玩家使用不同的身份。
MC_AUTH=microsoft
MC_USERNAME=
MC_SNAPSHOT_INTERVAL_MS=5000
# 默认仅观测。启用操作后，本地终端可控制，游戏聊天仅接受配置的玩家。
MC_CONTROL=false
MC_AUTHORIZED_PLAYERS=
# 仅对使用离线认证的隔离世界启用。
MC_ALLOW_OFFLINE_CONTROL=false

# 可选的 OpenAI 兼容 API。只在 GUI 选择外部 API 后发送对话和游戏观测。
# 保持密钥仅在本机 .env 中，或从桌面进程环境传入。
MCPAL_API_BASE_URL=
MCPAL_API_MODEL=
MCPAL_API_KEY=

# 可选的本机普通话识别。使用已安装 vosk 的 Python 和本机 Vosk 模型目录。
MCPAL_ASR_PYTHON=
MCPAL_ASR_MODEL=
